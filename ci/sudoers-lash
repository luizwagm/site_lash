# ==========================================================================
#  Regra de sudo da entrega automática — LA Software House
#
#  Instalar (uma vez, como root):
#      sudo cp ci/sudoers-lash /etc/sudoers.d/lash
#      sudo chmod 440 /etc/sudoers.d/lash
#      sudo visudo -c            # confere a sintaxe ANTES de confiar
#
#  POR QUE ELA É TÃO ESTREITA
#
#  O `deploy.sh` vem do repositório do GitHub. Autorizar `deploy` a rodá-lo com
#  sudo seria autorizar QUALQUER COISA como root — bastaria um commit trocando o
#  conteúdo do arquivo. E aqui o que está do outro lado é pesado: este servidor
#  guarda o Postgres com PRONTUÁRIO e ANAMNESE de pacientes, dado pessoal
#  sensível pela LGPD. Um vazamento de repositório não pode virar acesso a isso.
#
#  Aqui só três verbos, num serviço só, por caminho absoluto. O pior que um
#  commit malicioso consegue é reiniciar o próprio site — o mesmo poder que a
#  aplicação já tem.
#
#  Sem curinga no fim: `systemctl start lash.service` e nada além.
#  `systemctl start *` deixaria parar o postgresql, o nginx e o sshd.
# ==========================================================================

deploy ALL=(root) NOPASSWD: /usr/bin/systemctl start lash.service
deploy ALL=(root) NOPASSWD: /usr/bin/systemctl stop lash.service
deploy ALL=(root) NOPASSWD: /usr/bin/systemctl restart lash.service

# O prospector (worker do WhatsApp do /restrito) para e sobe junto no deploy —
# ele escreve no data/gestao.db, e mexer no banco com ele vivo perderia escrita.
deploy ALL=(root) NOPASSWD: /usr/bin/systemctl start lash-prospector.service
deploy ALL=(root) NOPASSWD: /usr/bin/systemctl stop lash-prospector.service
deploy ALL=(root) NOPASSWD: /usr/bin/systemctl restart lash-prospector.service

# Leitura: o deploy usa para descobrir o dono do serviço e conferir se subiu.
deploy ALL=(root) NOPASSWD: /usr/bin/systemctl is-active lash.service
deploy ALL=(root) NOPASSWD: /usr/bin/systemctl show lash.service -p User --value
deploy ALL=(root) NOPASSWD: /usr/bin/systemctl show lash.service -p Group --value
